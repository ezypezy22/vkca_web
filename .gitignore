# Build output — regenerated by build.bat / pyinstaller / Inno Setup
dist/
build/
AppDir/
*.AppImage

# Local venv used to build the Linux AppImage — regenerate with
# python3 -m venv --system-site-packages .buildvenv
.buildvenv/

# Third-party redistributables downloaded for the installer (~115MB,
# exceeds GitHub's 100MB file limit anyway)
vendor/
appimagetool-x86_64.AppImage

# Python bytecode cache
__pycache__/
*.pyc

# Runtime logs / local app state
*.log
vkcontest_config.json
vkca_web_settings.json
vkca_qrz_cache.json

# Local test/dev contest databases — contest logs, not source
*.s3db
*.db
*.sqlite
